# 웹 배포 환경변수 예시. 실제 값은 호스팅 대시보드의 비밀값으로 관리한다.

# ── 필수 ────────────────────────────────────────────────────────────────────
# 공용 비밀번호(12자 이상). 미설정 시 기동을 거부한다.
PNL_APP_PASSWORD=
# 세션 쿠키 서명 키. 비우면 비밀번호에서 파생한다(비밀번호 변경 시 세션 무효화).
PNL_SECRET_KEY=

# ── 판독 엔진 ───────────────────────────────────────────────────────────────
PNL_OCR_PROVIDER=claude
ANTHROPIC_API_KEY=
# WBS Code 후미를 가려 전송한다(1로 설정 시)
PNL_OCR_MASK=0

# ── 배포 ────────────────────────────────────────────────────────────────────
# HTTPS 뒤에 둘 때 1. 평문 HTTP면 0으로 두어야 쿠키가 전송된다.
PNL_SECURE_COOKIES=1
PNL_DATA_DIR=/data
# 같은 오리진에서 SPA를 서빙하므로 비워 둔다.
PNL_CORS_ORIGINS=
# 예: postgresql+psycopg://user:pass@host:5432/pnl
PNL_DATABASE_URL=

# ── 운영 기준 ───────────────────────────────────────────────────────────────
PNL_SESSION_HOURS=12
PNL_LOGIN_MAX_ATTEMPTS=10
PNL_UNBILLED_THRESHOLD=50000000
PNL_MAX_UPLOAD_BYTES=15728640
